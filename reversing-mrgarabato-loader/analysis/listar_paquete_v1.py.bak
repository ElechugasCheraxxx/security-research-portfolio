#!/usr/bin/env python3
"""Lista el contenido del paquete de 1.6 GB del panel SIN descargarlo entero.

El archivo es un RAR5 de 1.598.804.135 bytes con 'Accept-Ranges: bytes'.
En RAR5 las cabeceras de cada fichero van en linea dentro del archivo, no en
un directorio central al final, pero cada cabecera indica el tamano de los
datos que la siguen: asi que se puede recorrer la cadena saltando de cabecera
en cabecera leyendo solo unos pocos KB por tramo.

Objetivo: identificar por nombre y tamano los ficheros del paquete, y en
concreto los payloads que el loader inyecta en el emulador.
"""
import sys
import requests

URL = "https://panel.mrgarabato.com/Download/FreeFire/Requirements%20ByPass.rar"
CHUNK = 0x8000          # 32 KB por lectura
MAX_REQS = 400

s = requests.Session()
s.headers["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"

_cache = {}


def get(pos, n):
    """Lee n bytes desde pos, con cache por tramo."""
    key = (pos, n)
    if key in _cache:
        return _cache[key]
    r = s.get(URL, headers={"Range": "bytes=%d-%d" % (pos, pos + n - 1)}, timeout=60)
    data = r.content
    _cache[key] = data
    return data


class Cur:
    """Lector de VINT (entero variable de RAR) sobre un buffer con posicion."""

    def __init__(self, buf, pos=0):
        self.b = buf
        self.p = pos

    def vint(self):
        v = 0
        shift = 0
        while self.p < len(self.b):
            c = self.b[self.p]
            self.p += 1
            v |= (c & 0x7F) << shift
            shift += 7
            if not (c & 0x80):
                break
        return v


def walk():
    pos = 8                      # tras la firma "Rar!\x1a\x07\x01\x00"
    entries = []
    reqs = 0
    while reqs < MAX_REQS:
        reqs += 1
        buf = get(pos, CHUNK)
        if len(buf) < 16:
            print("  [fin de datos en 0x%x]" % pos)
            break
        c = Cur(buf, 4)
        hsize = c.vint()      # se cuenta DESDE este campo vint hasta el final
        if hsize <= 0 or hsize + 4 > len(buf):
            need = (hsize + 4) if hsize > 0 else CHUNK
            buf = get(pos, min(need + 4096, 1 << 20))
            if len(buf) < 16:
                print("  [fin de datos en 0x%x]" % pos)
                break
            c = Cur(buf, 4)
            hsize = c.vint()
        if hsize <= 0 or hsize + 4 > len(buf):
            print("  [cabecera invalida en 0x%x (size=%d, buffer=%d)]" % (pos, hsize, len(buf)))
            break
        htype = c.vint()
        hflags = c.vint()
        extra = c.vint() if (hflags & 0x0001) else 0
        datasz = c.vint() if (hflags & 0x0002) else 0

        info = ""
        if htype == 2:                          # FILE HEADER
            fflags = c.vint()
            unp = c.vint()
            attr = c.vint()
            if fflags & 0x0002:
                c.p += 4                        # mtime
            if fflags & 0x0004:
                c.p += 4                        # crc32
            c.vint()                            # info de compresion
            c.vint()                            # host os
            nlen = c.vint()
            name = buf[c.p:c.p + nlen].decode("utf-8", "replace")
            c.p += nlen
            info = "%-52s %12d B" % (name, unp)

        if htype in (2, 3, 4, 5):               # ficheros, servicio, dir, cifrado
            if info:
                print("  0x%012x  %s" % (pos, info))
            if htype == 2:
                entries.append((pos, info))
        elif htype == 1 and info:
            print("  0x%012x  ARCHIVE %s" % (pos, info))

        if htype == 5:                          # ENDARC: se acabo
            print("  [ENDARC en 0x%x]" % pos)
            break

        pos += 4 + hsize + datasz   # CRC(4) + cabecera + datos
        if _cache and len(_cache) > 8:
            _cache.pop(next(iter(_cache)))
    return entries, reqs


def main():
    print("Recorriendo el indice RAR5 por rangos (sin descargar el archivo)...")
    print("-" * 78)
    entries, reqs = walk()
    print("-" * 78)
    print("  %d ficheros indexados en %d peticiones" % (len(entries), reqs))
    return 0


if __name__ == "__main__":
    sys.exit(main())